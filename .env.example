PORT=4110
MONGODB_URI=mongodb://127.0.0.1:27019/vomtek_platform
JWT_SECRET=replace-with-64-character-random-string
ENGINE_URL=http://localhost:4210
CORS_ORIGINS=*
SEED_ON_BOOT=true
# Private lead delivery. Leave blank in source control.
LEAD_NOTIFY_EMAIL=
SMTP_HOST=smtp.mail.yahoo.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
WHATSAPP_TO=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en_US
# Credential-free email relay fallback used when SMTP_PASS is blank.
FORM_SUBMIT_ORIGIN=https://vomtek.com
# Optional: CallMeBot WhatsApp key. Activate once from the destination phone.
CALLMEBOT_API_KEY=
